# ─────────────────────────────────────────────────────────────
# 简历星球 · 可选配置（复制本文件为 .env 后填写，.env 不会被提交）
#   cp .env.example .env
# 改完执行：npm start（重新启动服务后生效）
#
# AI 对话需要配置 DeepSeek；未配置时接口会明确报错，不使用规则引擎替代语义理解。
# ─────────────────────────────────────────────────────────────

# ── 大模型（LLM）─────────────────────────────────────────────
# Resume Harness 通过供应商无关接口调用 DeepSeek Responses API。
# 局部用 Flash；全局与恢复用 Pro，优先保证完整文档操作可靠性。
RESUME_MODEL_PROVIDER=deepseek
RESUME_MODEL_API_KEY=sk-在这里填你的密钥
RESUME_MODEL_ENDPOINT=https://api.deepseek.com/responses
RESUME_MODEL_TEXT_MODEL=deepseek-v4-flash
RESUME_MODEL_COMPLEX_MODEL=deepseek-v4-pro
RESUME_GLOBAL_AI_REASONING_EFFORT=low
RESUME_MODEL_VISION_MODEL=deepseek-v4-flash-vision-exp
RESUME_MODEL_FIRST_TOKEN_MS=30000
RESUME_MODEL_IDLE_MS=30000
RESUME_MODEL_TOTAL_MS=180000
RESUME_MODEL_MAX_TOKENS=4096
# 全局 AI 按简历复杂度动态选择输出预算；首次请求偏向最小变化区域，
# 遇到截断或不完整 JSON 时最多提高一次，但不会突破下面的硬上限。
RESUME_MODEL_MIN_OUTPUT_TOKENS=4096
# 首次请求的软上限；恢复请求可在确有需要时继续提高。
RESUME_MODEL_INITIAL_MAX_TOKENS=16384
# 所有全局 AI 请求的绝对上限，防止异常输出失控。
RESUME_MODEL_MAX_TOKENS_LIMIT=32768
# 文档结构识别会返回较长 JSON；未设置时沿用上面的值。
# RESUME_DOCUMENT_AI_MAX_TOKENS=10000

# ── 云 OCR（可选）───────────────────────────────────────────
# 不填也能用：图片岗位截图会提示你直接粘贴文字（不臆造内容）。
# 接口契约：POST {file_name, mime_type, content_base64} → {text, confidence}
RESUME_OCR_ENDPOINT=
RESUME_OCR_API_KEY=

# ── 其它（可选）─────────────────────────────────────────────
# PORT=8787
# RESUME_DB_PATH=./data/resume.db
# RESUME_FONT_PATH=/home/ubuntu/.fonts/NotoSansSC.ttf
# RESUME_DOWNLOAD_SECRET=换成一个随机字符串
