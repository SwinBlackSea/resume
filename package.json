{
  "name": "resume-planet",
  "version": "1.3.0",
  "private": true,
  "description": "简历星球 · AI Native 简历工作台（PRD v1.3 / TECH v1.3）",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
